# GEOFRETE Environment Configuration
PROJECT_NAME="GEOFRETE - Otimizador de Rotas Last-Mile"
VERSION="1.0.0"
ENVIRONMENT=development

# Database (PostgreSQL + PostGIS)
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
DB_NAME=delivery_optimizer
DATABASE_URL=postgresql://postgres:postgres@db:5432/delivery_optimizer

# Redis / Celery Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Security
SECRET_KEY=generate_a_secure_secret_key_here_for_production

# Geocoding Service
GEOCODING_TIMEOUT_SECONDS=5
GEOCODING_MAX_RETRIES=3
GEOCODING_USER_AGENT=GEOFRETE-LastMileDelivery/1.0
